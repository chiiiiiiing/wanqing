#!/usr/bin/env python3
"""
reminder-pusher — 晚晴定时提醒闭环的"最后一公里"

Agent Stack Scheduler 到点触发后，提醒只停留在云端 session 里。
本守护进程负责：
  1. 每 30 秒轮询 GET /api/schedulers，检测 lastFiredAt 变化；
  2. 首次发现触发时，从 scheduler 的 prompt 中提取提醒文案；
  3. 通过 MQTT 推送到手机 App 的 chat 下行 topic：
       announcement/{USER_ID}/{DEVICE_ID}/chat/{channel}/out
     App 收到后经 BLE 下发给设备（TTS + 提醒 UI + 振动）。

同时订阅 chat/# 通配符，记录 App 最近使用的 channel，
保证主动推送落在 App 正在监听的 channel 上；
并记录老人最近互动时间（/in 流量）供家人关注服务使用。

零第三方依赖（MQTT-over-WebSocket 实现见同目录 mqttws.py）。
日志: ~/.roro/reminder-pusher.log（launchd 重定向）
状态: ~/.roro/reminder-pusher-state.json
"""

import json
import os
import signal
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mqttws import MQTTWebSocket
from deliver import deliver

# ── Config ───────────────────────────────────────────────────────
RORO_HOME = os.path.expanduser("~/.rorolee")
ENV_FILE = os.path.join(RORO_HOME, "bridge.env")
STATE_FILE = os.path.expanduser("~/.roro/reminder-pusher-state.json")

MQTT_BROKER = "mqtt.deotaland.ai"
MQTT_PORT = 8083
USER_ID = "106"
DEVICE_ID = "d-c0065571f81bbe36"

POLL_INTERVAL = 30          # scheduler 轮询间隔（秒）
CATCHUP_WINDOW = 3600       # 首次启动时补推最近 N 秒内已触发的提醒
DEFAULT_CHANNEL = "main"    # 未观察到 App channel 时的兜底

running = True

def sig_handler(sig, frame):
    global running
    log("收到退出信号，停止")
    running = False

signal.signal(signal.SIGINT, sig_handler)
signal.signal(signal.SIGTERM, sig_handler)

def log(msg):
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] {msg}", flush=True)

# ── Config / state ───────────────────────────────────────────────
def load_config():
    cfg = {}
    if os.path.isfile(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    for key in ("AGENT_STACK_BASE_URL", "AGENT_STACK_USER_API_KEY", "AGENT_STACK_PROJECT_ID"):
        if not os.environ.get(key) and not cfg.get(key):
            log(f"缺少配置 {key}（{ENV_FILE}）")
            sys.exit(1)
        cfg[key] = os.environ.get(key) or cfg[key]
    return cfg

def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {}

def save_state(state):
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, ensure_ascii=False, indent=1)
    os.replace(tmp, STATE_FILE)

# ── Agent Stack API ──────────────────────────────────────────────
def fetch_schedulers(cfg):
    """拉取全部 scheduler（翻页）。"""
    base = cfg["AGENT_STACK_BASE_URL"].rstrip("/")
    headers = {
        "Authorization": f"Bearer {cfg['AGENT_STACK_USER_API_KEY']}",
        "x-agent9-project-id": cfg["AGENT_STACK_PROJECT_ID"],
    }
    schedulers, cursor = [], None
    for _ in range(10):  # 最多翻 10 页，防止死循环
        url = f"{base}/api/schedulers?limit=50"
        if cursor:
            url += f"&cursor={urllib.parse.quote(cursor)}"
        req = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = json.loads(resp.read().decode())
        except (urllib.error.URLError, TimeoutError) as e:
            log(f"拉取 schedulers 失败: {e}")
            return None
        schedulers.extend(data.get("schedulers", []))
        cursor = data.get("nextCursor")
        if not cursor:
            break
    return schedulers

def extract_reminder_text(sched):
    """从 scheduler 的 prompt 中提取提醒文案。
    prompt 形如:
      '[schedule] 标题\\n{"message": "提醒：该吃药啦！"}'   # 两行
      '[schedule] 标题 {"message": "..."}'                 # 同行带 JSON 尾巴
    """
    title = sched.get("title", "提醒")
    prompt = sched.get("prompt", "")
    # 尝试从任意位置提取 JSON 中的 message 字段
    for line in prompt.splitlines():
        idx = line.find('{')
        while idx >= 0:
            try:
                msg = json.loads(line[idx:]).get("message")
                if msg:
                    return title, msg
            except json.JSONDecodeError:
                pass
            idx = line.find('{', idx + 1)
    # 兜底：去掉 [schedule] 前缀和 JSON 尾巴后的剩余文本
    lines = []
    for l in prompt.splitlines():
        l = l.strip()
        if not l:
            continue
        if l.startswith("[schedule]"):
            l = l[len("[schedule]"):].strip()
            # 去掉同行尾部可能的 JSON 与标题本身（标题与 title 重复）
            brace = l.find('{')
            if brace >= 0:
                l = l[:brace].strip()
            if l and l != title:
                lines.append(l)
        elif not l.startswith('{'):
            lines.append(l)
    text = " ".join(lines) or title
    return title, text

# ── 推送 ─────────────────────────────────────────────────────────
def push_reminder(mqtt, state, sched):
    title, text = extract_reminder_text(sched)
    full = f"⏰ 提醒：{title}\n{text}"
    now_ms = int(time.time() * 1000)

    via, detail = deliver(state, full)
    if via == "jsonl":
        # roro daemon mirror 会把新条目经 watermark/replay 投给 App（TTS + UI）
        log(f"已推送提醒 [jsonl mirror] {title}: {text[:50]}")
    else:
        # 兜底：App 未托管时直接发布（消息留在 broker，待 App 上线 replay）
        channel = state.get("last_channel") or DEFAULT_CHANNEL
        out_topic = f'announcement/{USER_ID}/{DEVICE_ID}/chat/{channel}/out'
        mqtt.publish(out_topic, json.dumps({
            "text": full,
            "type": "assistant",
            "timestamp": now_ms,
        }, ensure_ascii=False))
        # 结构化 reminder（协议 v1 预留，App 支持后可触发专属提醒 UI/振动）
        mqtt.publish(out_topic, json.dumps({
            "type": "reminder",
            "id": sched.get("schedulerId", ""),
            "title": title,
            "text": text,
            "importance": "important",
            "timestamp": now_ms,
        }, ensure_ascii=False))
        log(f"已推送提醒 [{channel} mqtt 兜底] {title}: {text[:50]}")

    state["last_push_at"] = time.strftime("%Y-%m-%dT%H:%M:%S+08:00")

# ── Main loop ────────────────────────────────────────────────────
def main():
    cfg = load_config()
    state = load_state()
    fired = state.get("fired", {})       # schedulerId -> lastFiredAt
    first_run = not state.get("booted")
    if first_run:
        state["booted"] = True

    mqtt = MQTTWebSocket(MQTT_BROKER, MQTT_PORT)
    mqtt.connect(client_id=f'reminder-pusher-{os.getpid()}')
    watch_topic = f'announcement/{USER_ID}/{DEVICE_ID}/#'
    mqtt.subscribe(watch_topic, qos=0)
    log(f"已启动。MQTT 连接成功，订阅 {watch_topic}")
    log(f"轮询间隔 {POLL_INTERVAL}s，当前已记录 {len(fired)} 条 scheduler 状态")

    last_poll = 0.0
    while running:
        # ── 处理入站消息：从 chat 流量学习 App 实际使用的 channel ──
        # roro daemon 会持续向 chat/{channel}/out 发 watermark，
        # 其 channel 即 App 当前监听的会话；/in 同理。
        try:
            result = mqtt.recv_message(timeout=1)
        except Exception as e:
            # 连接断开（recv 立即 EOF）：退避重连，避免空转烧 CPU
            log(f"MQTT 连接异常（{e}），5s 后重连…")
            time.sleep(5)
            if not running:
                break
            try:
                mqtt = MQTTWebSocket(MQTT_BROKER, MQTT_PORT)
                mqtt.connect(client_id=f'reminder-pusher-{os.getpid()}')
                mqtt.subscribe(watch_topic, qos=0)
                log("MQTT 重连成功")
            except Exception as e2:
                log(f"重连失败: {e2}")
            continue
        if result:
            topic, payload = result
            parts = topic.split('/')
            # event topic：从中学习 App 当前托管的会话（mirror 投递目标）
            if len(parts) >= 4 and parts[3] == 'event':
                try:
                    ev = json.loads(payload)
                    groups = (ev.get('payload') or {}).get('groups') or {}
                    for g in groups.get('claude', []) or []:
                        for s in g.get('sessions', []) or []:
                            if s.get('managed'):
                                ms = {"id": s.get('id'), "cwd": g.get('cwd')}
                                if state.get("managed_session") != ms:
                                    state["managed_session"] = ms
                                    save_state(state)
                                    log(f"观察到托管会话: {ms['id']}（{ms['cwd']}）")
                except Exception:
                    pass
            # announcement/106/{device}/chat/{channel}/(in|out)
            elif len(parts) >= 6 and parts[3] == 'chat' and parts[5] in ('in', 'out'):
                ch = parts[4]
                changed = False
                if state.get("last_channel") != ch:
                    state["last_channel"] = ch
                    changed = True
                    log(f"观察到 App channel: {ch}（来自 {parts[5]} 流量）")
                # /in = 老人语音上行，即真实互动；记录供家人关注服务使用
                if parts[5] == 'in':
                    state["last_interaction_at"] = time.strftime(
                        "%Y-%m-%dT%H:%M:%S+08:00")
                    changed = True
                if changed:
                    save_state(state)

        # ── 定时轮询 schedulers ──
        now = time.time()
        if now - last_poll < POLL_INTERVAL:
            continue
        last_poll = now

        schedulers = fetch_schedulers(cfg)
        if schedulers is None:
            continue

        for sched in schedulers:
            sid = sched.get("schedulerId")
            last_fired = sched.get("lastFiredAt")
            if not sid or not last_fired:
                continue
            if fired.get(sid) == last_fired:
                continue
            # 新触发（或首次见到）
            fired[sid] = last_fired
            try:
                # lastFiredAt 为 UTC（如 2026-08-28T20:00:00.000Z）
                fired_ts = time.mktime(time.strptime(
                    last_fired.split('.')[0], "%Y-%m-%dT%H:%M:%S"))
                fired_ts += time.timezone  # UTC → 本地 epoch 修正
            except Exception:
                fired_ts = now
            age = now - fired_ts
            if first_run and age > CATCHUP_WINDOW:
                continue  # 首次启动只补推最近窗口内的，避免刷屏
            push_reminder(mqtt, state, sched)

        state["fired"] = fired
        save_state(state)
        first_run = False

    mqtt.close()
    log("已退出")

if __name__ == '__main__':
    main()
