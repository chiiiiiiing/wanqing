# 晚晴配置模板。复制变量名到本地 shell / secret manager；禁止提交真实值。

# Agent Stack / claude-bridge
AGENT_STACK_BASE_URL=https://ventured-agent-stack.pingcap.cn
AGENT_STACK_USER_API_KEY=<your-user-api-key>
AGENT_STACK_PROJECT_ID=<your-project-id>
AGENT_STACK_AGENT_ID=<your-agent-id>

# Local MCP / REST / SQLite
MCP_URL=http://127.0.0.1:8200/mcp
MCP_PORT=8200
PORT=8100
WANQING_DB=./wanqing.db
BACKEND_URL=http://127.0.0.1:8100

# Optional public MCP tunnel
SERVEO_URL=https://<your-subdomain>.serveousercontent.com

# Optional family-care（家人端 :8100）
# FAMILY_TOKEN=<your-family-token>      # 不设则首次请求自动生成于 ~/.rorolee/family.token
# FAMILY_ALERT_HOURS=24                  # 无互动告警阈值（小时）