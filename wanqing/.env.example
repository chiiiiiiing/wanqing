# ─────────────────────────────────────────────────────────────
# 晚晴 (WanQing) — 配置模板
# 复制到实际位置后填入真实值；真实凭证禁止提交到仓库
# ─────────────────────────────────────────────────────────────

# 1) MCP Server / Backend（本机运行，无需修改）
# MCP_PORT=8200
# API_PORT=8100
# WANQING_DB=~/.roro/wanqing.db

# 2) claude-bridge（roro ↔ Agent Stack 桥接）
#    复制本文件为 ~/.rorolee/bridge.env 并填入真实值
AGENT_STACK_BASE_URL=https://your-agent-stack.example.com
AGENT_STACK_USER_API_KEY=sk-your-user-api-key
AGENT_STACK_PROJECT_ID=proj_xxxxxxxxxxxx
AGENT_STACK_AGENT_ID=agent_xxxxxxxxxxxx

# 3) serveo 隧道（MCP 公网暴露，可选；也可用 ngrok / cloudflared）
#    ssh -T -o StrictHostKeyChecking=no -R 80:localhost:8200 serveo.net
# SERVEO_URL=https://xxxx.serveousercontent.com
